# 复制这份文件并重命名为 .env，然后填入你自己的密钥
# cp .env.example .env（Windows: Copy-Item .env.example .env）
#
# 这个文件里只允许出现「占位符」，不要在这里填写任何真实密钥或地址：
# 真实的 .env 已经被 .gitignore 忽略，而 .env.example 是可以分享、上传的。

# 阿里云百炼 API Key（云端 Embedding 调用时用）
# 把等号右边整段替换成你自己的密钥，其余内容不要改
DASHSCOPE_API_KEY=your_api_key_here

# 阿里云百炼 Embedding 接口地址（可选，留空即可）
# 如果你使用「业务空间专属地址」，请把 YOUR_WORKSPACE_ID 换成自己的 WorkspaceId：
#   DASHSCOPE_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 留空则使用默认的云服务公开地址：https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=

# 服务端口，默认 3000
PORT=3000
